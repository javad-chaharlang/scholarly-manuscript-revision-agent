{
  "$defs": {
    "ApprovalState": {
      "enum": [
        "NOT_REQUIRED",
        "PENDING",
        "APPROVED",
        "REJECTED",
        "REVISION_REQUESTED"
      ],
      "title": "ApprovalState",
      "type": "string"
    },
    "ChangeType": {
      "enum": [
        "ADDITION",
        "REWRITE",
        "DELETION",
        "RELOCATION",
        "REFERENCE_ADDITION",
        "REFERENCE_CORRECTION",
        "FIGURE_REVISION",
        "TABLE_REVISION",
        "EQUATION_REVISION",
        "FORMATTING",
        "EXPERIMENTAL_ADDITION",
        "STATISTICAL_ANALYSIS",
        "GENERAL_CORRECTION"
      ],
      "title": "ChangeType",
      "type": "string"
    },
    "HighlightColor": {
      "enum": [
        "YELLOW",
        "BRIGHT_GREEN",
        "LIGHT_BLUE",
        "PINK",
        "TEAL",
        "DARK_YELLOW",
        "GRAY_25",
        "DARK_BLUE",
        "RED",
        "VIOLET"
      ],
      "title": "HighlightColor",
      "type": "string"
    },
    "RevisionStatus": {
      "enum": [
        "NOT_STARTED",
        "ANALYZED",
        "PLANNED",
        "DRAFTED",
        "APPLIED",
        "VERIFIED",
        "DEFERRED",
        "NOT_APPLICABLE"
      ],
      "title": "RevisionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "minLength": 1,
      "title": "Action Id",
      "type": "string"
    },
    "applied_location": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applied Location"
    },
    "approval_decision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Decision"
    },
    "approval_state": {
      "$ref": "#/$defs/ApprovalState",
      "default": "PENDING"
    },
    "author_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Note"
    },
    "change_type": {
      "$ref": "#/$defs/ChangeType"
    },
    "comment_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Comment Ids",
      "type": "array"
    },
    "decision_maker": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Maker"
    },
    "decision_timestamp": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Timestamp"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "evidence_request": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Request"
    },
    "evidence_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Requirements",
      "type": "array"
    },
    "experiment_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Experiment Requirements",
      "type": "array"
    },
    "highlight": {
      "anyOf": [
        {
          "$ref": "#/$defs/HighlightColor"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "modified_action_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Modified Action Text"
    },
    "old_text_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Old Text Summary"
    },
    "proposed_revision_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposed Revision Summary"
    },
    "proposed_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposed Text"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "reference_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Reference Requirements",
      "type": "array"
    },
    "statistical_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Statistical Requirements",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/RevisionStatus",
      "default": "PLANNED"
    },
    "target_object": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Object"
    },
    "target_section": {
      "minLength": 1,
      "title": "Target Section",
      "type": "string"
    },
    "unresolved_questions": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Questions",
      "type": "array"
    },
    "verified_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified At"
    },
    "verified_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified By"
    }
  },
  "required": [
    "action_id",
    "comment_ids",
    "change_type",
    "target_section",
    "rationale"
  ],
  "title": "RevisionAction",
  "type": "object"
}
