{
  "$defs": {
    "ProjectState": {
      "enum": [
        "NEW",
        "INTAKE_PENDING",
        "INTAKE_REVIEW",
        "GAP_ANALYSIS_PENDING",
        "PLAN_APPROVAL",
        "REVISION_DRAFTING",
        "TEXT_APPROVAL",
        "REVISION_APPLICATION",
        "SCIENTIFIC_QA",
        "RESPONSE_PREPARATION",
        "VISUAL_QA",
        "READY_FOR_RELEASE",
        "RELEASED",
        "BLOCKED"
      ],
      "title": "ProjectState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Current state only; the append-only timeline retains all prior events.",
  "properties": {
    "blocked_from": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "next_required_action": {
      "minLength": 1,
      "title": "Next Required Action",
      "type": "string"
    },
    "previous_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/ProjectState"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "state",
    "next_required_action",
    "sequence",
    "updated_at"
  ],
  "title": "ProjectStateRecord",
  "type": "object"
}
