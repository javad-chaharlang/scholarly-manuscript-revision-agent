{
  "$defs": {
    "RevisionStatus": {
      "enum": [
        "NOT_STARTED",
        "ANALYZED",
        "PLANNED",
        "DRAFTED",
        "APPLIED",
        "VERIFIED",
        "DEFERRED",
        "NOT_APPLICABLE"
      ],
      "title": "RevisionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "author_approved": {
      "default": false,
      "title": "Author Approved",
      "type": "boolean"
    },
    "comment_id": {
      "title": "Comment Id",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "final_status": {
      "$ref": "#/$defs/RevisionStatus",
      "default": "NOT_STARTED"
    },
    "highlight_verified": {
      "default": false,
      "title": "Highlight Verified",
      "type": "boolean"
    },
    "interpretation_complete": {
      "default": false,
      "title": "Interpretation Complete",
      "type": "boolean"
    },
    "last_checked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Checked At"
    },
    "location_verified": {
      "default": false,
      "title": "Location Verified",
      "type": "boolean"
    },
    "manuscript_change_ids": {
      "items": {
        "type": "string"
      },
      "title": "Manuscript Change Ids",
      "type": "array"
    },
    "reference_ids": {
      "items": {
        "type": "string"
      },
      "title": "Reference Ids",
      "type": "array"
    },
    "required_action_ids": {
      "items": {
        "type": "string"
      },
      "title": "Required Action Ids",
      "type": "array"
    },
    "response_entry_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Entry Id"
    },
    "scientific_claims_verified": {
      "default": false,
      "title": "Scientific Claims Verified",
      "type": "boolean"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "unresolved_issues": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Issues",
      "type": "array"
    }
  },
  "required": [
    "trace_id",
    "comment_id"
  ],
  "title": "TraceabilityRecord",
  "type": "object"
}
