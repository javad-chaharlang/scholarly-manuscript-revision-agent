{
  "$defs": {
    "AgentAuthorDecision": {
      "enum": [
        "APPROVE_IMPORT",
        "REJECT_OUTPUT"
      ],
      "title": "AgentAuthorDecision",
      "type": "string"
    },
    "AgentRunStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED_RAW",
        "VALIDATING",
        "VALIDATED",
        "AUTHOR_REVIEW",
        "APPROVED",
        "REJECTED",
        "IMPORTED",
        "FAILED",
        "CANCELLED",
        "BLOCKED",
        "RECOVERY_REQUIRED"
      ],
      "title": "AgentRunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_paths": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifact Paths",
      "type": "object"
    },
    "author_decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentAuthorDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "author_decision_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Decision At"
    },
    "author_decision_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Decision By"
    },
    "cancellation_requested_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancellation Requested At"
    },
    "codex_executable": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Codex Executable"
    },
    "codex_pid": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Codex Pid"
    },
    "codex_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Codex Version"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "context_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Manifest Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "duration_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Seconds"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "failure_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Message"
    },
    "output_schema_name": {
      "minLength": 1,
      "title": "Output Schema Name",
      "type": "string"
    },
    "progress_percent": {
      "default": 0,
      "maximum": 100,
      "minimum": 0,
      "title": "Progress Percent",
      "type": "integer"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "prompt_version": {
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^RUN-[A-Z0-9-]{8,}$",
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/AgentRunStatus",
      "default": "QUEUED"
    },
    "structured_mode": {
      "minLength": 1,
      "title": "Structured Mode",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "validation_error_codes": {
      "items": {
        "type": "string"
      },
      "title": "Validation Error Codes",
      "type": "array"
    },
    "validation_passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Passed"
    },
    "worker_pid": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Pid"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "project_id",
    "created_at",
    "updated_at",
    "prompt_version",
    "prompt_sha256",
    "context_manifest_sha256",
    "output_schema_name",
    "structured_mode"
  ],
  "title": "AgentRun",
  "type": "object"
}
