{
  "$defs": {
    "CommentApprovalDecision": {
      "enum": [
        "APPROVE_PACKAGE",
        "APPROVE_WITH_MODIFICATION",
        "REQUEST_REWRITE",
        "NEED_MORE_EVIDENCE",
        "DEFER",
        "REJECT_REQUEST"
      ],
      "title": "CommentApprovalDecision",
      "type": "string"
    },
    "CommentApprovalRecord": {
      "additionalProperties": false,
      "description": "One atomic pre-application decision for a reviewer comment.",
      "properties": {
        "approval_id": {
          "minLength": 1,
          "title": "Approval Id",
          "type": "string"
        },
        "approved_draft_ids": {
          "items": {
            "type": "string"
          },
          "title": "Approved Draft Ids",
          "type": "array"
        },
        "approved_response": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved Response"
        },
        "author_modified_response": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author Modified Response"
        },
        "author_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author Note"
        },
        "comment_id": {
          "title": "Comment Id",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/CommentApprovalDecision"
        },
        "decision_maker": {
          "minLength": 1,
          "title": "Decision Maker",
          "type": "string"
        },
        "decision_timestamp": {
          "format": "date-time",
          "title": "Decision Timestamp",
          "type": "string"
        },
        "evidence_request": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Request"
        },
        "exact_comment_sha256": {
          "title": "Exact Comment Sha256",
          "type": "string"
        },
        "proposed_response": {
          "minLength": 1,
          "title": "Proposed Response",
          "type": "string"
        },
        "related_draft_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Related Draft Hashes",
          "type": "object"
        },
        "related_draft_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Draft Ids",
          "type": "array"
        },
        "rewrite_instruction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rewrite Instruction"
        },
        "source_document_hash": {
          "title": "Source Document Hash",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "comment_id",
        "exact_comment_sha256",
        "source_document_hash",
        "proposed_response",
        "decision",
        "decision_maker",
        "decision_timestamp"
      ],
      "title": "CommentApprovalRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete per-comment gate evaluated before any manuscript mutation.",
  "properties": {
    "records": {
      "items": {
        "$ref": "#/$defs/CommentApprovalRecord"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_document_hash": {
      "title": "Source Document Hash",
      "type": "string"
    }
  },
  "required": [
    "source_document_hash",
    "records"
  ],
  "title": "CommentApprovalBundle",
  "type": "object"
}
